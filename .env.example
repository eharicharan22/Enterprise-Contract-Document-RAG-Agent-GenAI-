# ============================================
# LLM PROVIDER — pick ONE and fill its key
# ============================================
LLM_PROVIDER=groq                 # options: openai | groq | ollama

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-70b-versatile

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ============================================
# EMBEDDINGS
# ============================================
# local = sentence-transformers (free, no key, runs on CPU)
# openai = text-embedding-3-small (needs OPENAI_API_KEY)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ============================================
# VECTOR STORE
# ============================================
VECTOR_STORE=chroma               # options: chroma | qdrant
CHROMA_PERSIST_DIR=./data/chroma_db
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=contract_docs

# ============================================
# CHUNKING
# ============================================
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ============================================
# HYBRID SEARCH WEIGHTS (must sum to 1.0)
# ============================================
DENSE_WEIGHT=0.6
SPARSE_WEIGHT=0.4
TOP_K=5
